{
  "$schema": "https://opencode.ai/config.json",
  "_comment_model": "Offline-first: default = local Ollama coder model. Claude & ChatGPT are opt-in via API keys. Do not hardcode cloud model versions.",
  "instructions": [
    "You are an expert software engineer. Default to English in code, docs, and issues. Respect CLAUDE.md per repo. Offline-first: local Ollama is the default model; Claude and ChatGPT are opt-in via API keys."
  ],
  "mcp": {
    "github": {
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "type": "local"
    },
    "notion": {
      "command": [
        "npx",
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "enabled": true,
      "environment": {
        "OPENAPI_MCP_HEADERS": "{\"Authorization\": \"Bearer ${NOTION_API_KEY}\", \"Notion-Version\": \"2022-06-28\"}"
      },
      "type": "local"
    }
  },
  "model": "ollama/qwen2.5-coder",
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    },
    "github-copilot": {
      "options": {
        "model": "claude-sonnet-4-6"
      },
      "type": "copilot"
    },
    "ollama": {
      "models": {
        "qwen2.5-coder": {
          "name": "Qwen2.5 Coder (local)"
        },
        "qwen3:8b": {
          "name": "Qwen3 8B (local)"
        }
      },
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:OLLAMA_URL}/v1"
      }
    },
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      }
    }
  }
}
